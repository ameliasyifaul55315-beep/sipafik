# SIPAFIK — TEMPLATE PRODUKSI INFINITYFREE
# Salin isi ini ke file .env di folder htdocs. Jangan bagikan isi .env.
APP_NAME=SIPAFIK
APP_ENV=production
APP_KEY=ISI_APP_KEY_BARU_DARI_LARAGON
APP_DEBUG=false
APP_URL=https://ISI_DOMAIN_ANDA
APP_FORCE_HTTPS=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=ISI_MYSQL_HOST_DARI_PANEL_INFINITYFREE
DB_PORT=3306
DB_DATABASE=ISI_NAMA_DATABASE
DB_USERNAME=ISI_USERNAME_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log
